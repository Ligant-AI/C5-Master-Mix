# Response headers for the Pages project. The page also carries a meta CSP, but
# frame-ancestors cannot be delivered from a meta element, so the policy has to
# be sent here as well.
#
# Copied from C7 (Ligant-AI/C7-Reconstitution at 9b942e3), policy unchanged; only
# this comment is rewritten. Scripts, styles and fonts are 'self' only; images are
# 'self' plus data: URIs (the favicon is one); connect-src has no 'self'. Beyond
# that, the policy allows only the analytics decided by A. Modi, the same as live C7,
# and the newsletter signup:
#   - Cloudflare Web Analytics, for every visitor: its beacon script from
#     static.cloudflareinsights.com and its reporting endpoint,
#     benchtools.ligant.ai/cdn-cgi/rum.
#   - Google Analytics, loaded only after the visitor clicks Allow in the suite
#     footer's banner (@ligant/bench-chrome): its script from
#     www.googletagmanager.com; images from *.google-analytics.com and
#     *.googletagmanager.com; connections to *.google-analytics.com,
#     *.analytics.google.com, *.googletagmanager.com, www.google.com and
#     *.g.doubleclick.net.
#   - The suite footer's newsletter signup (@ligant/bench-chrome 1.3.0): one
#     connection, benchtools.ligant.ai/api/subscribe, made only when the visitor
#     submits an email address there. It carries only that address and the
#     consent; nothing entered into the tool's fields is sent.
# No other edge-injected script (Rocket Loader, email obfuscation) may be added
# without changing this policy and the page's disclosure together.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js https://static.cloudflareinsights.com/beacon.min.js/ https://www.googletagmanager.com; style-src 'self'; font-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src https://benchtools.ligant.ai/cdn-cgi/rum https://benchtools.ligant.ai/api/subscribe https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://*.g.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()

# index.html must not outlive a deploy; the hashed assets can be cached hard.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Served without an extension, so the type has to be stated or it downloads
# instead of displaying. The footer links to it.
/LICENSE
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
